// ═══════════════════════════════════════════════════════════════════════════
// RATHJI PLUGIN TEMPLATE — blank plugin template
// ═══════════════════════════════════════════════════════════════════════════
//
// A Perchance plugin is just a normal generator that is written to be reused.
// The ONE special thing is the $output function at the bottom of this file:
// when another generator imports this one, `$output` is exactly what it gets.
// Everything else here — lists, data, helpers — exists to serve that function.
//
// This skeleton follows the structure of the card-deck-plugin
// (perchance.org/card-deck-plugin) and the "make your own plugin" step of
// Rathji's Plugin Tutorials (perchance.org/rathjis-plugin-tutorials).
//
// Other generators use it like this (NOTE: never type a bare import-block
// inside a plugin's own source — the import scanner would try to import it):
//   rathjiPluginTemplate = import:your-plugin-name     // ← top of their lists editor
//   [rathjiPluginTemplate("hello")]                    // ← from a list
//   outputEl.innerHTML = root.rathjiPluginTemplate("hello");   // ← from a <script>
//
// TO MAKE THIS YOURS:
//   1. Edit the $meta title/description/tags below.
//   2. Rename rathjiPluginTemplate* names to your plugin's name.
//   3. Write your real logic in the Helpers section; call it from $output.
//   4. Delete the Embedded data section if you don't need a payload.
//   5. Save, then import it anywhere using the standard import syntax.
// ═══════════════════════════════════════════════════════════════════════════

$meta
  title = Rathji Plugin Template
  description = A blank-but-working template for building a Perchance plugin: import it, rename the rathjiPluginTemplate* names, add your logic, and publish. Every plugin pattern (options nodes, preset lists, never-throw $output) is demonstrated live on this page.
  tags = plugin, template, starter, blank
  header
    mode = minimal


// ── 0. IMPORTS (optional) ───────────────────────────────────────────────────
// A named import binds another generator's $output to a name — this is also
// how users will import THIS generator. Replace it with whatever dependencies
// your plugin actually needs, or delete the section entirely.

simpleGenFooter = {import:simple-gen-footer}


// ── 1. EMBEDDED DATA (optional) ─────────────────────────────────────────────
// Big bundled payloads (svg templates, word lists, base64 assets, config...)
// live in ONE lazy-initialised bundle, created exactly once on first use —
// mirroring the initCardDeck()/window.CARD_DECK_PAYLOAD pattern in
// card-deck-plugin. Small plugins can delete this section AND the
// rathjiPluginTemplateDefaults() helper below.

initRathjiPluginTemplateData() =>
  window.RATHJI_PLUGIN_TEMPLATE_PAYLOAD = {
    version: 1,
    defaultEmoji: "✨",
    defaultColor: "#7c6cff",
    // TODO: bundle your plugin's real data here.
  };
  return window.RATHJI_PLUGIN_TEMPLATE_PAYLOAD;

rathjiPluginTemplateDefaults() =>
  if(!window.RATHJI_PLUGIN_TEMPLATE_PAYLOAD) initRathjiPluginTemplateData();
  return window.RATHJI_PLUGIN_TEMPLATE_PAYLOAD;


// ── 2. LISTS (data your plugin uses) ────────────────────────────────────────
// Users can pass these straight to your plugin. An options node is a list
// whose items are `key = value` pairs — the plugin reads each key, exactly
// like the `greetOpts` example in Rathji's tutorial step 4.

rathjiPluginTemplateOpts
  text = hello
  emoji = 🌊
  color = #22d3ee

// A list of preset options nodes. Pass the whole list and the plugin picks a
// random item — a handy way to offer the user "themes".

rathjiPluginTemplatePresets
  cosmic
    text = Cosmic
    emoji = 🌌
    color = #8b5cf6
  ocean
    text = Ocean
    emoji = 🌊
    color = #22d3ee
  ember
    text = Ember
    emoji = 🔥
    color = #f97316


// ── 3. HELPERS ──────────────────────────────────────────────────────────────
// Keep $output thin. Put the real work in named helpers (one job each), like
// cardDeckBuild()/cardDeckRecolor() do in card-deck-plugin. Helpers also stay
// reachable from the page as root.<name>, which makes them easy to test.

rathjiPluginTemplateResolve(v) =>
  if(v == null) return v;
  try {
    if(v.evaluateItem !== undefined) return v.evaluateItem; // pjs node → its evaluated value
  } catch(e) {}
  return v; // raw JS value → as-is

rathjiPluginTemplateStamp(text, opts) =>
  let emoji = opts.emoji || rathjiPluginTemplateDefaults().defaultEmoji;
  let color = opts.color || rathjiPluginTemplateDefaults().defaultColor;
  return '<span style="display:inline-block;background:' + color + '1a;color:' + color + ';border:1px solid ' + color + '66;border-radius:999px;padding:4px 14px;font-weight:600;font-family:system-ui,sans-serif;">' + emoji + " " + text + "</span>";


// ── 4. ENTRY POINT ($output) ────────────────────────────────────────────────
// The plugin-definition idiom (Rathji's tutorial, step 6 "Make your own
// plugin"). It accepts, all through ONE function:
//   rathjiPluginTemplate("hi")                       plain value
//   rathjiPluginTemplate("hi", {color:"#f00"})       value + options object
//   rathjiPluginTemplate({text:"hi", color:"#f00"})  options object alone
//   rathjiPluginTemplate(rathjiPluginTemplateOpts)               options read from a list node
//   rathjiPluginTemplate(rathjiPluginTemplatePresets)            a LIST of options → picks a random one
//
// Options are distinguished from plain values the way the text-to-image-plugin
// does it: an options node has a known key (here: `text`), a plain value does
// not. Every value — string, number, item — is read through .evaluateItem so
// Perchance lists work anywhere a plain value would.
//
// Never throw — return a readable "(...)" placeholder on bad input, just like
// card-deck-plugin returns "(unknown card id: ...)".

$output(input, opts) =>
  // A LIST of preset options (rathjiPluginTemplatePresets) has items but no `.text` key —
  // pick a random item first. A single options node (rathjiPluginTemplateOpts), an options
  // object, or a plain value all keep their own `.text` (or none at all).
  // A plain list of strings (items without `.text`) passes through untouched,
  // so `rathjiPluginTemplate(aPlainList)` evaluates to a random item — free list support.
  if(input != null && input.text === undefined && input.selectOne != null) {
    let item = null;
    try { item = input.selectOne; } catch(e) {}
    if(item != null && item !== input && item.text !== undefined) input = item;
  }

  let o = {};
  if(opts != null) {
    o.text = rathjiPluginTemplateResolve(input);
    o.emoji = rathjiPluginTemplateResolve(opts.emoji);
    o.color = rathjiPluginTemplateResolve(opts.color);
  } else if(input != null && input.text !== undefined) {
    o.text = rathjiPluginTemplateResolve(input.text);
    o.emoji = rathjiPluginTemplateResolve(input.emoji);
    o.color = rathjiPluginTemplateResolve(input.color);
  } else {
    o.text = rathjiPluginTemplateResolve(input);
  }

  if(typeof o.text !== "string" || !o.text.trim()) {
    return "(rathjiPluginTemplate: expected some text — got " + JSON.stringify(rathjiPluginTemplateResolve(input)) + ")";
  }

  return rathjiPluginTemplateStamp(o.text.trim(), o);
