$meta
  title = Template Jungle
  description = A living collection of Perchance templates — board games, video games, apps, art tools, frameworks and plugins. Browse, fork, and build.
  image = https://user.uploads.dev/file/8ddfd1ee7b823878eb39cd52b364cfe6.png
  tags = templates, hub, directory, board games, video games, apps, perchance
  header 
    mode = minimal

generateText = {import:ai-text-plugin}

// ============================================================================
//  TEMPLATE JUNGLE  —  CONFIGURATION
// ============================================================================
//
//  Everything the page shows lives in the `config` list below. Add or remove
//  templates, change descriptions, bump view counts, reorder categories —
//  the page renders entirely from this data.
//
//  Structure (field-by-field):
//    branding   — name, logo, tagline, footer text
//    theme      — light|dark, accent style, radius, font size, font family
//    colors     — brand palette (hex)
//    hero       — badge, headline, subheadline, CTAs, status chip
//    quickLinks — the strip of quick-jump chips under the hero
//    categories — the 5 groups the templates are organized into (id + label
//                 + icon + blurb). `id` matches each template's `category`.
//    templates  — one item per template: name (perchance slug), title,
//                 category (must match a category id), description, views,
//                 and an optional tag ("Featured" | "Private" | "").
//    how        — the 3 "how it works" steps
//    faq        — accordion Q&A
//    footer     — footer link columns
//
//  Editing tips:
//  • Add a template: copy an existing t# item, give it a new number, set its
//    fields. Stats (totals, most popular) are computed automatically.
//  • Strings are written raw (no quotes). Numbers are kept as numbers.
//  • In footerText, \{year\} and \{companyName\} are auto-filled.
// ============================================================================

config
  schemaVersion = 1.0.0

  // ── Brand identity ───────────────────────────────────────────────────────
  branding
    companyName = Template Jungle
    companyShortName = Jungle
    companyUrl = https://perchance.org/template-jungle
    logoGlyph = J
    logoUrl = 
    tagline = A living collection of Perchance templates
    footerText = © \{year\} \{companyName\}. Built with the business-template.

  // ── Visual theme ─────────────────────────────────────────────────────────
  theme
    mode = dark                      // light | dark
    accentStyle = gradient           // gradient | solid
    radius = 16
    fontSize = 16
    fontFamily = lato
    reduceMotion = false

  // ── Brand palette (hex colors) ───────────────────────────────────────────
  colors
    primary = #10b981                 // jungle emerald — CTAs, links, highlights
    secondary = #34d399               // soft mint — gradients, chips
    accent = #047857                  // deep green — badges, small details
    background = #f8fafc              // page background (light mode)
    surface = #ffffff                 // cards & section backgrounds (light mode)
    text = #0f172a                    // main text (light mode)
    textMuted = #64748b               // secondary text (light mode)

  // ── Hero ─────────────────────────────────────────────────────────────────
  hero
    badge = Your template hub
    headline = Every template you need, in one jungle.
    headlineAccent = one jungle.
    subheadline = A living collection of production-ready Perchance templates — board games, video games, apps, art tools, frameworks and plugins. Browse the canopy, fork a template, and build something great.
    primaryCta = Browse templates
    primaryCtaUrl = #templates
    secondaryCta = See how it works
    secondaryCtaUrl = #how
    status = Always growing · fork & build

  // ── Quick-jump chips (under the hero) ────────────────────────────────────
  quickLinks
    q1
      label = Apps & products
      url = #cat-apps
    q2
      label = Board games
      url = #cat-board-games
    q3
      label = Video games
      url = #cat-video-games
    q4
      label = Art & content
      url = #cat-art-content
    q5
      label = Frameworks & plugins
      url = #cat-frameworks

  // ── Template categories ──────────────────────────────────────────────────
  categories
    c1
      id = apps
      label = Apps & Products
      icon = rocket
      blurb = Full product templates — business sites, AI image and chat apps.
    c2
      id = board-games
      label = Board Game Templates
      icon = dice
      blurb = Ready-to-fork multiplayer tables from the Boardgame Network.
    c3
      id = video-games
      label = Video Game Templates
      icon = gamepad
      blurb = Ship a game on the Video Game Network — platformers to JRPGs.
    c4
      id = art-content
      label = Art & Content
      icon = palette
      blurb = Art generators and content tools.
    c5
      id = frameworks
      label = Frameworks & Plugins
      icon = puzzle
      blurb = Reusable frameworks and plugin templates.

  // ── Templates ────────────────────────────────────────────────────────────
  templates
    t1
      name = nucleus-app
      icon = ⚛️
      title = Nucleus
      category = apps
      description = A modern, full-featured image generation template. Describe a scene, enhance it with AI, pick a style lens and aspect ratio — with a vault, public gallery, seeds, re-rolls, sound and themes.
      views = 110
      tag = Most popular
    t2
      name = keystone-app
      icon = 💬
      title = Keystone Chat
      category = apps
      description = A full-featured AI chat template: editable history, personas & scenarios, one-click presets, themes and settings. Fork it and make it your own.
      views = 51
      tag = 
    t3
      name = business-template
      icon = 💼
      title = Business Template
      category = apps
      description = A professional, fully configurable project template. Brand it with your company details, scan a website for matching color schemes, and import/export the configuration as JSON.
      views = 20
      tag = Featured
    t4
