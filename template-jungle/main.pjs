            label = Apps & products
            url = #cat-apps
          l2
            label = Board games
            url = #cat-board-games
          l3
            label = Video games
            url = #cat-video-games
          l4
            label = Art & content
            url = #cat-art-content
          l5
            label = Frameworks & plugins
            url = #cat-frameworks
      col2
        heading = Networks
        links
          l1
            label = Perchance
            url = https://perchance.org
          l2
            label = Boardgame Network
            url = https://perchance.org/boardgame-network
          l3
            label = Video Game Network
            url = https://perchance.org/video-game-network
          l4
            label = Perchance plugins
            url = https://perchance.org/plugins
      col3
        heading = About
