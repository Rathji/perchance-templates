// ─────────────────────────────────────────────────────────────
//  BGN BLANK TEMPLATE — main.pjs
//  Page config + the server-plugin import that powers online
//  play. There is NO game logic yet — the multiplayer table
//  (rooms, turn order, presence) lives in index.html. Fork this
//  generator and build your own game on top.
// ─────────────────────────────────────────────────────────────

$meta
  title = BGN Blank Template
  description = A ready-to-fork multiplayer table for the Boardgame Network — online rooms, turn order and presence out of the box. No game yet: bring your own.
  tags = template, board game, two player, multiplayer, online, rooms
  image = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

hubUrl = https://perchance.org/bgn-boardgame-network  // ← SET THIS to your network hub's URL
projectsUrl = https://perchance.org/rathjis-generators  // ← SET THIS to your Perchance projects page (shown as "Rathji's Projects" in the top nav)
authorInitial = R  // initial shown on the "Rathji's Projects" badge
gameTitle = BGN Blank Template
gameTagline = A room is ready. Host or join, and the table handles the rest — bring your own game.
gameKicker = Host · Join · Play
gameGenre = Table
gamePlayers = 2 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

// Playing table backgrounds — select with [tableGraphics.selectOne], or access by id (root.tableGraphics.slate.url)
tableGraphics
  slate
    name = Slate
    url = https://user.uploads.dev/file/1c3362ef12b434367c151198fb9ba97c.jpg
  forge
    name = Forge
    url = https://user.uploads.dev/file/5756a746265c584ac77a701221aff3d7.jpg
  ember
    name = Ember
    url = https://user.uploads.dev/file/39143b5b1c649c5c07a5a54bccb9d09f.jpg

createServerSocket = {import:server-plugin}
